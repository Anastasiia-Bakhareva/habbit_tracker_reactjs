                  "});",
                  "",
                  "pm.test(\"Habits are sorted by title ascending\", function () {",
                  "    const titles = pm.response.json().map(function (h) { return h.title; });",
                  "    const sorted = titles.slice().sort();",
                  "    pm.expect(titles).to.eql(sorted);",
                  "});"
