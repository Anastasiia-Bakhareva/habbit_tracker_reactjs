    {
      "name": "05 Data-driven (запускать с habits_data.csv)",
      "item": [
        {
          "name": "POST habit from data file",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/habits",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "habits"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{title}}\",\n  \"frequency\": \"{{frequency}}\",\n  \"status\": \"active\",\n  \"createdAt\": \"2026-10-28\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "// Значения берутся из CSV на каждой итерации Collection Runner",
                  "const expectedTitle = pm.iterationData.get(\"title\");",
                  "const expectedFrequency = pm.iterationData.get(\"frequency\");",
                  "",
                  "if (expectedTitle) {",
                  "    pm.test(\"Created habit matches the data file row\", function () {",
                  "        const json = pm.response.json();",
                  "        pm.expect(json.title).to.eql(expectedTitle);",
                  "        pm.expect(json.frequency).to.eql(expectedFrequency);",
                  "    });",
                  "}",
                  "",
                  "// Чистим за собой: удаляем созданную запись следующим запросом",
                  "pm.environment.set(\"dataHabitId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE habit created from data file",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habits/{{dataHabitId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "habits",
                "{{dataHabitId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": "Откройте Collection Runner, выберите только эту папку и файл habits_data.csv: будет 3 итерации."
