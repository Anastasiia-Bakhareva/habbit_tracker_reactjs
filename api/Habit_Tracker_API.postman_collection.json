                  "});",
                  "",
                  "pm.test(\"Returns at most 2 habits\", function () {",
                  "    pm.expect(pm.response.json().length).to.be.at.most(2);",
                  "});",
                  "",
                  "pm.test(\"X-Total-Count header is present and numeric\", function () {",
                  "    pm.response.to.have.header(\"X-Total-Count\");",
                  "    pm.expect(Number(pm.response.headers.get(\"X-Total-Count\"))).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET full-text search (q=water)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habits?q=water",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "habits"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "water"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Search finds the Drink water habit\", function () {",
                  "    const habits = pm.response.json();",
                  "    pm.expect(habits.length).to.be.above(0);",
                  "    const titles = habits.map(function (h) { return h.title.toLowerCase(); });",
                  "    pm.expect(titles.some(function (t) { return t.includes(\"water\"); })).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Completions (nested resource)",
      "item": [
        {
          "name": "GET completions of habit 1 (nested route)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habits/{{existingHabitId}}/completions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "habits",
                "{{existingHabitId}}",
                "completions"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"All completions belong to the habit\", function () {",
                  "    const items = pm.response.json();",
                  "    pm.expect(items.length).to.be.above(0);",
                  "    items.forEach(function (c) {",
                  "        pm.expect(String(c.habitId)).to.eql(pm.environment.get(\"existingHabitId\"));",
                  "        pm.expect(c.date).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST mark habit as completed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/completions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "completions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"habitId\": 1,\n  \"date\": \"2026-10-28\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Completion is created for habit 1\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "    pm.expect(json.habitId).to.eql(1);",
                  "    pm.expect(json.date).to.eql(\"2026-10-28\");",
                  "});",
                  "",
                  "pm.environment.set(\"completionId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
