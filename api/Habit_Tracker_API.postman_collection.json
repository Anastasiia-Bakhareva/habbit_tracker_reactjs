          "name": "GET page 1, limit 2",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habits?_page=1&_limit=2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "habits"
              ],
              "query": [
                {
                  "key": "_page",
                  "value": "1"
                },
                {
                  "key": "_limit",
                  "value": "2"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
