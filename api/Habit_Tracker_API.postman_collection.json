{
  "info": {
    "name": "Habit Tracker API",
    "description": "Практика API-тестирования на json-server (db.json). Базовый URL берётся из окружения.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Habits CRUD",
      "item": [
        {
          "name": "GET all habits",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habits",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "habits"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is a non-empty array\", function () {",
                  "    const habits = pm.response.json();",
                  "    pm.expect(habits).to.be.an(\"array\");",
                  "    pm.expect(habits.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"Every habit has required fields with valid types\", function () {",
                  "    pm.response.json().forEach(function (h) {",
                  "        pm.expect(h).to.have.property(\"id\");",
                  "        pm.expect(h.title).to.be.a(\"string\");",
                  "        pm.expect(h.frequency).to.be.oneOf([\"daily\", \"weekly\"]);",
                  "        pm.expect(h.status).to.be.oneOf([\"active\", \"archived\"]);",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Content-Type is JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"Response time < 500ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET habit by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habits/{{existingHabitId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "habits",
                "{{existingHabitId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Habit id matches requested id\", function () {",
                  "    const habit = pm.response.json();",
                  "    pm.expect(String(habit.id)).to.eql(pm.environment.get(\"existingHabitId\"));",
                  "    pm.expect(habit.title).to.be.a(\"string\").and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST create habit (random title)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/habits",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "habits"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{randomTitle}}\",\n  \"frequency\": \"daily\",\n  \"status\": \"active\",\n  \"createdAt\": \"2026-10-28\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Генерируем уникальное название перед каждым запуском",
                  "pm.variables.set(\"randomTitle\", \"Habit \" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response contains sent data and a new id\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "    pm.expect(json.title).to.eql(pm.variables.get(\"randomTitle\"));",
                  "    pm.expect(json.frequency).to.eql(\"daily\");",
                  "    pm.expect(json.status).to.eql(\"active\");",
                  "});",
                  "",
                  "// Сохраняем id для следующих запросов",
                  "pm.environment.set(\"newHabitId\", pm.response.json().id);",
                  "pm.environment.set(\"newHabitTitle\", pm.response.json().title);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET created habit",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habits/{{newHabitId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "habits",
                "{{newHabitId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Created habit is persisted\", function () {",
                  "    pm.expect(pm.response.json().title).to.eql(pm.environment.get(\"newHabitTitle\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT replace habit",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/habits/{{newHabitId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "habits",
                "{{newHabitId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Replaced habit\",\n  \"frequency\": \"weekly\",\n  \"status\": \"active\",\n  \"createdAt\": \"2026-10-28\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Habit is fully replaced\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.title).to.eql(\"Replaced habit\");",
                  "    pm.expect(json.frequency).to.eql(\"weekly\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH archive habit",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/habits/{{newHabitId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "habits",
                "{{newHabitId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"archived\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Only status changed, other fields are kept\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"archived\");",
                  "    pm.expect(json.title).to.eql(\"Replaced habit\");",
                  "    pm.expect(json.frequency).to.eql(\"weekly\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE habit",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habits/{{newHabitId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "habits",
                "{{newHabitId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET deleted habit (expect 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habits/{{newHabitId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "habits",
                "{{newHabitId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Deleted habit is not found (404)\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": "Полный цикл: создать, прочитать, заменить, изменить, удалить, проверить удаление. Запускайте по порядку."
    },
    {
      "name": "02 Filtering, sorting, pagination",
      "item": [
        {
          "name": "GET active habits",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habits?status=active",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "habits"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "active"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"All returned habits are active\", function () {",
                  "    const habits = pm.response.json();",
                  "    pm.expect(habits.length).to.be.above(0);",
                  "    habits.forEach(function (h) {",
                  "        pm.expect(h.status).to.eql(\"active\");",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET weekly habits",
          "request": {
            "method": "GET",
